{
  "name": "juris-desktop",
  "version": "1.0.0",
  "description": "Juris - gestão de processos, prazos e compromissos advocatícios",
  "main": "main.js",
  "author": "Juris",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.0.5"
  },
  "build": {
    "appId": "br.com.juris.desktop",
    "productName": "Juris",
    "files": [
      "index.html",
      "manifest.json",
      "sw.js",
      "main.js",
      "preload.js",
      "node_modules/pdfjs-dist/legacy/build/pdf.mjs",
      "node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "sign": false,
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Juris-${version}-${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "pdfjs-dist": "^6.3.289"
  }
}
